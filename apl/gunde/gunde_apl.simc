actions=bloodbound_spirit,if=buff.reign_in_blood.up
actions+=/reign_in_blood
actions+=/owed_in_blood,target_if=debuff.open_wounds.up,if=!buff.bloodcraze.up&buff.owed_in_blood.stack>=30&buff.reign_in_blood.up&!legendary.lego_3
actions+=/owed_in_blood,target_if=max:debuff.open_wounds.remains,if=!buff.bloodcraze.up&legendary.lego_3&(buff.deaths_arc.up|!talent.deaths_arc)
actions+=/sahrils_wrath,if=buff.spirit_of_heroism.up|spirit.deficit>=90
actions+=/voidbringers_touch
actions+=/slaughter,if=fight_remains<=10
actions+=/heart_splitter,if=rend_stacks_on_target>=200&(talent.oathshatter|active_enemies<=3)
actions+=/slaughter,if=talent.massacre&blessing.the_philosopher&(cooldown.heart_splitter.charges=0|active_enemies>2&!talent.oathshatter)&(!cooldown.grim_carve.up|active_enemies<3)&rend_stacks_on_target>=100
actions+=/fated_strike,if=!cooldown.heart_splitter.up&active_enemies<3|active_enemies>3&!cooldown.grim_carve.up
actions+=/blood_arc,if=active_enemies<3&cooldown.rupture.up&!buff.serrated_edge.up|active_enemies>3&cooldown.grim_carve.up
actions+=/rupture,if=buff.serrated_edge.up&active_enemies<=2|active_enemies>2
actions+=/blood_arc,if=buff.carrion_onslaught.up&buff.deaths_arc.up&active_enemies>1
actions+=/grim_carve,if=buff.grim_harvest.up
actions+=/heart_splitter,if=full_recharge_time<=gcd.max*3&(active_enemies<3|talent.oathshatter)
actions+=/heart_splitter,if=buff.serrated_edge.up&(active_enemies<3|talent.oathshatter)&(talent.darkening_hearts&target.health.pct<=30|legendary.lego_2&target.health.pct>=80|legendary.lego_2)
actions+=/slaughter,if=(!talent.massacre|!blessing.the_philosopher)&(!cooldown.heart_splitter.up|active_enemies>2&!talent.oathshatter)&!cooldown.grim_carve.up&debuff.open_wounds.up&!legendary.lego_2&debuff.open_wounds.up
actions+=/grim_carve
actions+=/blood_arc
actions+=/fated_strike
actions+=/earthbreaker
actions+=/reavers_edge
actions+=/double_strike