actions+=/alzeracs_shackle
actions+=/shining_halo,if=!buff.shining_halo.up
actions+=/decree_of_the_sun
actions+=/omnistrike
actions+=/brilliant_flash,if=buff.omega_reprieval.at_max_stacks|buff.omega_reprieval.stack>1&cooldown.omega_reprieval.remains<=gcd.max+3*talent.celestial_favor
