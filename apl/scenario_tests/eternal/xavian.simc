sets.seal_of_the_heskyr=1
sets.dark_prophecy=1

actions.precombat=snapshot_stats
actions.precombat+=/variable,name=aura_farm,op=reset,default=0
actions.precombat+=/variable,name=taunt_max,op=reset,default=0
actions.precombat+=/aura_of_solace

actions=solar_shield
actions+=/solar_blades
actions+=/aura_of_solace,if=variable.aura_farm
actions+=/taunt,if=full_recharge_time<=3&!buff.golden_hour.up&variable.taunt_max
actions+=/alzeracs_shackle
actions+=/shining_halo,if=!buff.shining_halo.up
actions+=/decree_of_the_sun
actions+=/omnistrike
actions+=/brilliant_flash,if=buff.omega_reprieval.at_max_stacks|buff.omega_reprieval.stack>1&cooldown.omega_reprieval.remains<=gcd.max+3*talent.celestial_favor
actions+=/omega_reprieval
actions+=/blinding_slash,target_if=min:debuff.blind.stack,if=debuff.blind.stack<1|!talent.gleaming_strikes&active_enemies>1
actions+=/fated_strike
actions+=/brilliant_flash
actions+=/sun_strike,if=talent.gleaming_strikes
actions+=/blinding_slash,if=active_enemies>1
actions+=/sun_strike


legendary.solar_glare=1
talents=vanguard_of_vengeance:1/invictus:1/golden_hour:1/solar_burn:1/rising_sun:1/suns_touch:1

