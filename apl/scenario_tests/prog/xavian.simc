actions=solar_shield
#,if=talent.invictus
actions+=/solar_blades
actions+=/alzeracs_shackle
actions+=/shining_halo,if=!buff.shining_halo.up
actions+=/decree_of_the_sun
actions+=/omnistrike
actions+=/brilliant_flash,if=buff.omega_reprieval.at_max_stacks|buff.omega_reprieval.stack>1&cooldown.omega_reprieval.remains<=gcd.max+3*talent.celestial_favor
actions+=/omega_reprieval
actions+=/blinding_slash,target_if=min:debuff.blind.stack,if=debuff.blind.stack<1|!talent.gleaming_strikes&active_enemies>1
actions+=/fated_strike
actions+=/brilliant_flash
actions+=/sun_strike,if=talent.gleaming_strikes
actions+=/blinding_slash
actions+=/sun_strike

weapon=fated_strike


