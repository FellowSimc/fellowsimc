talents=high_road:1/square_hammer:1/mouth_for_war:1/bloodline:1/ride_the_lightning:1/schism:1/far_beyond_driven:1/them_bones:1/crack_the_sky:1


actions.precombat=snapshot_stats

actions.finishers=/
actions.finishers+=/hammer_storm,if=buff.schism_hammer_storm.up&(buff.focused_wrath.up|active_enemies>=2&(buff.schism_hammer_storm.stack=2|buff.schism_hammer_storm.remains<=gcd.max*3))
actions.finishers+=/skull_crusher,if=buff.schism_skull_crusher.up&(buff.schism_skull_crusher.stack=2|buff.schism_skull_crusher.remains<=gcd.max*3|buff.focused_wrath.up)
actions.finishers+=/skull_crusher,if=(talent.schism)&(fury>50)
#&(fury>=90|fight_remains<=10|buff.thunder_call.up)
actions.finishers+=/hammer_storm,if=active_enemies>=3&(fury>50|fight_remains<=10|buff.thunder_call.up&buff.thunder_call.remains<=gcd.max)
#&(!talent.schism|fury>=50)
actions.finishers+=/skull_crusher,if=active_enemies<3&(fury>50|fight_remains<=10|buff.thunder_call.up&buff.thunder_call.remains<=gcd.max)

actions=/
actions+=/thunder_call
actions+=/raging_tempest,if=!buff.thunder_call.up
actions+=/leap_smash,if=talent.high_road&fury.deficit>=20|talent.mouth_for_war&!buff.focused_wrath.at_max_stacks|legendary.slayers_mosh|1
actions+=/voidbringers_touch
actions+=/sahrils_wrath,if=buff.thunder_call.up
actions+=/focused_wrath,if=buff.focused_wrath.stack<2
actions+=/culling_strike,if=active_enemies<=20&(fury>=10)|buff.executioners_grin.up|talent.pneuma
actions+=/heavy_strike,if=buff.kill_em_all.up
actions+=/chain_lightning,if=fury.deficit>=10
actions+=/heavy_strike,if=fury.deficit>=12
actions+=/call_action_list,name=finishers
#,if=fury.deficit>=12
actions+=/face_breaker,if=fury.deficit>=7
actions+=/fated_strike
#,if=fury.deficit>=7

#&(!talent.schism|fury>50)
# actions+=/skull_crusher,if=buff.schism_skull_crusher.up&(fury>=90|fight_remains<=10|buff.thunder_call.up)
