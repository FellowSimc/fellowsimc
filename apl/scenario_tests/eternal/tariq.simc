# actions+=/skull_crusher,if=(active_enemies<=2|talent.sledgehammer|talent.schism)&(fury>=80|fight_remains<=10|buff.thunder_call.up)|talent.schism&fury>50
# actions+=/hammer_storm,if=(active_enemies>=3)&(fury>=80|fight_remains<=10|buff.thunder_call.up)
actions+=/earthbreaker
actions+=/wild_swing


copy="CJ Apl"

actions=/
actions+=/thunder_call
actions+=/call_action_list,name=fated_strike_pre_sequence_into_fated_strike,if=cooldown.fated_strike.ready
actions+=/raging_tempest
actions+=/leap_smash,if=fury.deficit>=15
actions+=/voidbringers_touch
actions+=/sahrils_wrath,if=buff.thunder_call.up|buff.raging_tempest.up
actions+=/focused_wrath
actions+=/culling_strike,if=active_enemies<=20
actions+=/heavy_strike,if=fury.deficit>=12
actions+=/chain_lightning,if=legendary.thundering_vortex|talent.thunderstruck&fury.deficit>=10
actions+=/call_action_list,name=finishers,if=buff.thunder_call.up|buff.raging_tempest.up
actions+=/chain_lightning
actions+=/face_breaker,if=fury.deficit>=7
actions+=/call_action_list,name=finishers
actions+=/wild_swing

actions.precombat=/
actions.precombat+=/snapshot_stats

actions.finishers=/
actions.finishers+=/hammer_storm,if=talent.schism&buff.schism_hammer_storm.at_max_stacks&active_enemies>1
actions.finishers+=/hammer_storm,if=talent.schism&buff.schism_hammer_storm.up&active_enemies>1&debuff.slayers_mosh.remains>gcd&(buff.thunder_call.up|buff.raging_tempest.up)
actions.finishers+=/hammer_storm,if=talent.schism&buff.schism_hammer_storm.up&active_enemies>1&(buff.thunder_call.remains<gcd*2|buff.raging_tempest.remains<gcd*2)
actions.finishers+=/hammer_storm,if=talent.schism&buff.schism_hammer_storm.up&active_enemies=1&buff.focused_wrath.up
actions.finishers+=/hammer_storm,if=!talent.schism&active_enemies>=3
actions.finishers+=/skull_crusher,if=(talent.schism&!(buff.schism_hammer_storm.at_max_stacks&active_enemies>1))|(!talent.schism&active_enemies<=2)

actions.fated_strike_pre_sequence_into_fated_strike=/
actions.fated_strike_pre_sequence_into_fated_strike+=/hammer_storm,if=buff.schism_hammer_storm.at_max_stacks&fury>85&cooldown.leap_smash.ready&talent.high_road
actions.fated_strike_pre_sequence_into_fated_strike+=/skull_crusher,if=fury>85&cooldown.leap_smash.ready&talent.high_road
actions.fated_strike_pre_sequence_into_fated_strike+=/leap_smash,if=fury.deficit>=15&talent.high_road
actions.fated_strike_pre_sequence_into_fated_strike+=/fated_strike
